# ===== 本项目数据：只保留处理代码，数据与产物一律不入库 =====
# 原始数据（读者按 README 指引从 quotsoft.net 下载后放回 data/raw）
data/raw/
# 最终处理数据
data/processed/
# Spark 中间产物（part 文件、校验文件、_SUCCESS、TSV）
data/interim/**/part-*
data/interim/**/*.crc
data/interim/**/_SUCCESS
data/interim/sql_analysis/*.tsv
# 算法结果产物（由 run_pipeline.py 重新生成）
data/analysis/output/
# 说明：data/analysis/*.py、data/interim/*.md、data/interim/sql_analysis/*.sql 保留

